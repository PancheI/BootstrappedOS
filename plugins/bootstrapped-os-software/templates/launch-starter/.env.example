# Copy to .env.local. Every service is optional: the site works without it and says what's missing.

# The live address, for links in emails, the sitemap and the checkout's return page (Vercel sets VERCEL_URL;
# set this once you have a domain). In production it must start with https://.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments (AgentaOS by default; test keys start with sk_test_). Create the plans with: npm run plans
AGENTAOS_API_KEY=

# Supabase (Project settings -> API Keys). The secret key stays on the server (waitlist);
# the publishable key (sb_publishable_..., or the legacy anon key) is for sign-in and is safe to expose.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Analytics (PostHog: Project settings -> Project API key)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
